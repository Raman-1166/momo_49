# Server Configuration
PORT=3001
NODE_ENV=development
ALLOWED_ORIGIN=http://localhost:5173

# Admin Security
# Generate bcrypt hash: node -e "console.log(require('bcryptjs').hashSync('YOUR_PASSWORD', 10))"
ADMIN_PASSWORD_HASH=$2b$10$tMxyOSw4WE3gXU3F1xo4XOqm0ZXoeQl3xfq/u2c6aefLnbO5pOdSq
ADMIN_SESSION_SECRET=change_this_to_a_random_32_byte_string_in_production

# Payment Gateway (Razorpay / Stripe)
# Test or Live keys
RAZORPAY_KEY_ID=rzp_test_placeholder_key_id
RAZORPAY_KEY_SECRET=rzp_test_placeholder_secret
WEBHOOK_SECRET=whsec_test_hmac_secret_key_32_bytes_long

# CSRF & Token Secrets
INTERNAL_API_SECRET=momo_internal_secure_salt_key

